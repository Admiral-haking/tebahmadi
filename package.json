{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "APP_ENV=local APP_RUNTIME=node PAYMENT_PROVIDER=mock SHIPPING_PROVIDER=mock SMS_PROVIDER=mock ADMIN_SESSION_SECRET=local-admin-secret OTP_PEPPER=local-otp-pepper node scripts/run-framework.mjs dev",
    "build": "APP_ENV=local APP_RUNTIME=node node scripts/run-framework.mjs build",
    "start": "APP_ENV=local APP_RUNTIME=node PAYMENT_PROVIDER=mock SHIPPING_PROVIDER=mock SMS_PROVIDER=mock ADMIN_SESSION_SECRET=local-admin-secret OTP_PEPPER=local-otp-pepper node scripts/run-framework.mjs dev",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "node --test --import tsx tests/**/*.test.ts",
    "test:e2e": "playwright test",
    "test:all": "pnpm lint && pnpm test && pnpm typecheck && pnpm test:e2e && pnpm build",
    "verify:release": "pnpm config:verify:production && pnpm test:all && pnpm db:verify",
    "config:verify:server": "node --import tsx scripts/verify-server-config.mjs",
    "smoke:local": "node scripts/smoke-local.mjs",
    "smoke:local:with-server": "node scripts/smoke-local-with-server.mjs",
    "config:verify:production": "node --import tsx scripts/verify-production-config.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "node --import tsx scripts/local-node-db.mjs migrate",
    "db:reset:local": "node --import tsx scripts/local-node-db.mjs reset",
    "db:verify": "node --import tsx scripts/local-node-db.mjs verify",
    "db:seed:local": "node --import tsx scripts/local-node-db.mjs seed",
    "db:backup:local": "node --import tsx scripts/local-node-db.mjs backup",
    "db:verify:backup": "node --import tsx scripts/local-node-db.mjs verify-backup",
    "db:reset:node": "node --import tsx scripts/local-node-db.mjs reset"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
