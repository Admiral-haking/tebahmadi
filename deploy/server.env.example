# Copy this file to /home/ali/tebahmadi/.env.server on the server.
# Keep the copied file mode 600. Never commit real values.
APP_ENV=server
APP_RUNTIME=node
NEXT_PUBLIC_SITE_URL=https://tebahmadi.ir

# Keep these mock until the corresponding provider credentials and callback tests exist.
PAYMENT_PROVIDER=mock
SHIPPING_PROVIDER=mock

# SMS.ir is the active OTP provider on the server.
SMS_PROVIDER=sms_ir
SMS_IR_API_KEY=replace-with-sms-ir-api-key
SMS_IR_OTP_TEMPLATE_ID=replace-with-approved-otp-template-id

# Generate both values with: openssl rand -hex 32
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
OTP_PEPPER=replace-with-a-separate-random-secret

# Optional provider settings. Leave empty while the adapters are mock.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_AMOUNT_UNIT=toman
TAPIN_TOKEN=
TAPIN_SHOP_ID=
TAPIN_BASE_URL=https://api.tapin.ir/api/v2/public
