# Local development defaults to mock providers. Never commit real values here.
APP_ENV=local
MEDIA_ROOT=.local/media
NEXT_PUBLIC_SITE_URL=https://tebahmadi.ir
PAYMENT_PROVIDER=mock
SHIPPING_PROVIDER=mock
PAYMENT_API_URL=
PAYMENT_API_TOKEN=
SHIPPING_API_URL=
SHIPPING_API_TOKEN=

# Required for admin session signing in a non-mock environment.
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret
OTP_PEPPER=replace-with-a-separate-random-secret

# SMS.ir OTP. Keep mock for local development; never commit the API key.
SMS_PROVIDER=mock
SMS_IR_API_KEY=
SMS_IR_OTP_TEMPLATE_ID=

# ZarinPal: use sandbox=true during verification; amount unit is toman or rial.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZARINPAL_AMOUNT_UNIT=toman

# Tapin shipping adapter. Tapin remains disabled until both values exist.
TAPIN_TOKEN=
TAPIN_SHOP_ID=
TAPIN_BASE_URL=https://api.tapin.ir/api/v2/public
