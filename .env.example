# Database/auth
MONGO_URI=mongodb://127.0.0.1:27017/tebahmadi
JWT_SECRET=replace-with-at-least-32-random-characters
APP_BASE_URL=https://tebahmadi.ir
NEXT_PUBLIC_SITE_URL=https://tebahmadi.ir

# SMS.ir (production) or mock (local)
SMS_PROVIDER=mock
SMS_IR_API_KEY=
SMS_IR_OTP_TEMPLATE_ID=
SMS_IR_TEMPLATE_PARAMETER=CODE
# Optional: allow this normalized admin phone to continue with a code read from the local database if SMS.ir is unavailable.
OTP_MANUAL_FALLBACK_PHONE=

# Tapin shipping adapter
TAPIN_TOKEN=
TAPIN_SHOP_ID=
TAPIN_BASE_URL=https://api.tapin.ir/api/v2/public
TAPIN_TIMEOUT_MS=10000

# Existing payment configuration
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
